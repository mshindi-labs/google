{
  "name": "@mshindi-labs/google",
  "version": "1.0.2",
  "description": "Multi-tenant Gmail and Google API utilities for TypeScript applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mshindi-labs/google.git"
  },
  "homepage": "https://github.com/mshindi-labs/google#readme",
  "bugs": {
    "url": "https://github.com/mshindi-labs/google/issues"
  },
  "type": "module",
  "exports": {
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./gmail": {
      "import": {
        "types": "./dist/gmail.d.ts",
        "default": "./dist/gmail.js"
      },
      "require": {
        "types": "./dist/gmail.d.cts",
        "default": "./dist/gmail.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.js"
      },
      "require": {
        "types": "./dist/postgres.d.cts",
        "default": "./dist/postgres.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:package": "vitest run --config vitest.package.config.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "google-auth-library": "^9.15.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-kms": "^3.0.0",
    "@google-cloud/kms": "^4.0.0",
    "@googleapis/gmail": "^12.0.0",
    "html-to-text": "^9.0.0",
    "mailparser": "^3.0.0",
    "nodemailer": "^6.9.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-kms": {
      "optional": true
    },
    "@googleapis/gmail": {
      "optional": true
    },
    "@google-cloud/kms": {
      "optional": true
    },
    "html-to-text": {
      "optional": true
    },
    "mailparser": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "^3.700.0",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@commitlint/types": "^20.4.3",
    "@electric-sql/pglite": "^0.2.0",
    "@google-cloud/kms": "^4.5.0",
    "@googleapis/gmail": "^12.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^18.19.0",
    "@types/nodemailer": "^6.4.17",
    "html-to-text": "^9.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.16",
    "prettier": "^3.4.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "google",
    "gmail",
    "oauth2",
    "multi-tenant",
    "typescript"
  ],
  "author": "mshindi-labs",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "vite": "^6"
  }
}
